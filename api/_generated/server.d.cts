/**
 * Type contract for the server bundle generated by
 * scripts/bundle-server-for-vercel.mjs during the Vercel build.
 *
 * The .cjs file is generated at build time and intentionally is not committed.
 */
type GeneratedServerHandler = {
  fetch: (request: Request, env: unknown, ctx: unknown) => Promise<Response> | Response;
};

declare const serverModule: {
  default?: GeneratedServerHandler;
  fetch?: GeneratedServerHandler["fetch"];
};

export default serverModule;
